{
  "version": 1,
  "servers": {
    "gke": {
      "transport": "http",
      "url": "https://container.googleapis.com/mcp/read-only",
      "auth": {
        "google_oauth": {
          "scopes": ["https://www.googleapis.com/auth/cloud-platform"]
        }
      },
      "tools": [
        "list_clusters",
        "get_cluster",
        "get_k8s_resource",
        "describe_k8s_resource",
        "get_k8s_logs",
        "list_k8s_events"
      ]
    },
    "lookout": {
      "transport": "stdio",
      "command": "/usr/local/bin/lookout",
      "args": [
        "mcp",
        "--tools=k8s_audit_all",
        "--clusters-from=auto",
        "--max-concurrency-per-cluster=8"
      ]
    },
    "leeway": {
      "transport": "stdio",
      "command": "/usr/local/bin/leeway",
      "args": [
        "mcp",
        "--timeout=20s",
        "--parallelism=32"
      ],
      "agentic_never": true
    }
  }
}
