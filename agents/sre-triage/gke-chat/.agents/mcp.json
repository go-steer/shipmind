{
  "version": 1,
  "servers": {
    "lookout": {
      "transport": "stdio",
      "command": "/usr/local/bin/lookout",
      "args": [
        "mcp",
        "--tools=k8s_audit_all,k8s_triage_workload,k8s_resource_spec,k8s_triage_logs,k8s_event_timeline,k8s_list_resources,k8s_state_edges,k8s_triage_delta",
        "--clusters-from=auto",
        "--max-concurrency-per-cluster=8"
      ]
    },
    "leeway": {
      "transport": "stdio",
      "command": "/usr/local/bin/leeway",
      "args": [
        "mcp",
        "--timeout=20s",
        "--parallelism=32"
      ],
      "agentic_never": true
    }
  }
}
