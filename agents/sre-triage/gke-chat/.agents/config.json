{
  "version": 1,
  "agent": {
    "description": "Answers questions about GKE clusters, investigates live workloads, and reviews cluster posture in a conversation.",
    "display_name": "gke-chat",
    "final_report": true,
    "max_session_cost_usd": 10,
    "max_steps": 50,
    "max_wallclock_seconds": 600
  },
  "attach": {
    "allowed_hosts": [
      "atenet-router.ate-system.svc.cluster.local",
      "atenet-router.ate-system.svc",
      "atenet-router.ate-system"
    ],
    "multi_session": {
      "auth": {
        "token_identity": "switchboard"
      },
      "enabled": true
    }
  },
  "model": {
    "builtin_tools": {
      "code_execution": false,
      "url_context": false,
      "web_search": false
    },
    "name": "gemini-3.8-flash"
  },
  "permissions": {
    "allow": [
      "mcp:lookout_k8s_list_clusters*",
      "mcp:lookout_k8s_audit_all*",
      "mcp:lookout_k8s_triage_workload*",
      "mcp:lookout_k8s_resource_spec*",
      "mcp:lookout_k8s_triage_logs*",
      "mcp:lookout_k8s_event_timeline*",
      "mcp:lookout_k8s_list_resources*",
      "mcp:lookout_k8s_state_edges*",
      "mcp:lookout_k8s_triage_delta*",
      "mcp:leeway_report*",
      "skill:list_skills*",
      "skill:load_skill*",
      "skill:load_skill_resource*"
    ],
    "mode": "ask"
  },
  "tools": {
    "policies": [
      {
        "mutating": false,
        "name": "k8s_list_clusters"
      },
      {
        "mutating": false,
        "name": "k8s_audit_all"
      },
      {
        "mutating": false,
        "name": "k8s_triage_workload"
      },
      {
        "mutating": false,
        "name": "k8s_resource_spec"
      },
      {
        "mutating": false,
        "name": "k8s_triage_logs"
      },
      {
        "mutating": false,
        "name": "k8s_event_timeline"
      },
      {
        "mutating": false,
        "name": "k8s_list_resources"
      },
      {
        "mutating": false,
        "name": "k8s_state_edges"
      },
      {
        "mutating": false,
        "name": "k8s_triage_delta"
      },
      {
        "mutating": false,
        "name": "report"
      }
    ]
  }
}
