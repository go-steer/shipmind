{
  "version": 1,
  "agent": {
    "description": "Autonomous triage of GKE cluster incidents surfaced by k8s-lookout.",
    "display_name": "gke-triage-f",
    "final_report": true,
    "max_steps": 8,
    "max_wallclock_seconds": 150
  },
  "attach": {
    "allowed_hosts": [
      "atenet-router.ate-system.svc.cluster.local",
      "atenet-router.ate-system.svc",
      "atenet-router.ate-system"
    ]
  },
  "model": {
    "builtin_tools": {
      "code_execution": false,
      "url_context": false,
      "web_search": false
    },
    "name": "gemini-3.8-flash"
  },
  "permissions": {
    "allow": [
      "mcp:lookout_k8s_list_clusters*",
      "mcp:lookout_k8s_triage_workload*",
      "mcp:lookout_k8s_resource_spec*",
      "mcp:lookout_k8s_triage_logs*",
      "mcp:lookout_k8s_event_timeline*",
      "mcp:lookout_k8s_list_resources*",
      "mcp:lookout_k8s_state_edges*",
      "mcp:lookout_k8s_triage_delta*",
      "skill:list_skills*",
      "skill:load_skill*",
      "skill:load_skill_resource*"
    ],
    "approval_timeout": "30s",
    "mode": "ask"
  },
  "tools": {
    "policies": [
      {
        "mutating": false,
        "name": "k8s_list_clusters"
      },
      {
        "mutating": false,
        "name": "k8s_triage_workload"
      },
      {
        "mutating": false,
        "name": "k8s_resource_spec"
      },
      {
        "mutating": false,
        "name": "k8s_triage_logs"
      },
      {
        "mutating": false,
        "name": "k8s_event_timeline"
      },
      {
        "mutating": false,
        "name": "k8s_list_resources"
      },
      {
        "mutating": false,
        "name": "k8s_state_edges"
      },
      {
        "mutating": false,
        "name": "k8s_triage_delta"
      }
    ]
  }
}
