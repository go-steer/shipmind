# The ax Workspace mounted into every incident task at /workspace/repo;
# mast reads its AGENTS.md ahead of every prompt (--instructions).
apiVersion: ax.io/v1alpha1
kind: Workspace
metadata:
  name: {{ printf "%q" .Workspace }}
  atespace: {{ printf "%q" .Atespace }}
spec:
  files:
    - path: AGENTS.md
      content: {{ printf "%q" .AgentsMD }}
