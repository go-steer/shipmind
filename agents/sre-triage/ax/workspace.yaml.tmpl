# The ax Workspace mounted into every incident and chat task at
# /workspace/repo; mast reads its AGENTS.md ahead of every prompt
# (--instructions), and core-agent loads it via --agents-content-dir.
# When agent.vcs is set, propose-config.json carries the propose task's
# core-agent config (gke-chat's base config plus the environment's vcs
# repositories).
apiVersion: ax.io/v1alpha1
kind: Workspace
metadata:
  name: {{ printf "%q" .Workspace }}
  atespace: {{ printf "%q" .Atespace }}
spec:
  files:
    - path: AGENTS.md
      content: {{ printf "%q" .AgentsMD }}
{{- if .ProposeConfig }}
    - path: propose-config.json
      content: {{ printf "%q" .ProposeConfig }}
{{- end }}
