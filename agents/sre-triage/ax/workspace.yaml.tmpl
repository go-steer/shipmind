# The ax Workspace mounted into every incident, watchboard, and chat task at
# /workspace/repo; core-agent loads its AGENTS.md via --agents-content-dir.
# When agent.vcs, slack.alertChannel, or audits.autoPR is set,
# chat-config.json, incident-config.json, watchboard-config.json, and/or
# audit-config.json carry the augmented core-agent configs layered on top of
# the baked bundle recipes.
apiVersion: ax.io/v1alpha1
kind: Workspace
metadata:
  name: {{ printf "%q" .Workspace }}
  atespace: {{ printf "%q" .Atespace }}
spec:
  files:
    - path: AGENTS.md
      content: {{ printf "%q" .AgentsMD }}
{{- if .ChatConfig }}
    - path: chat-config.json
      content: {{ printf "%q" .ChatConfig }}
{{- end }}
{{- if .IncidentConfig }}
    - path: incident-config.json
      content: {{ printf "%q" .IncidentConfig }}
{{- end }}
{{- if .WatchboardConfig }}
    - path: watchboard-config.json
      content: {{ printf "%q" .WatchboardConfig }}
{{- end }}
{{- if .AuditConfig }}
    - path: audit-config.json
      content: {{ printf "%q" .AuditConfig }}
{{- end }}
