# The ax task the agent runs as on core-agent, in serve mode (#48),
# rendered once per use with that use's bundle:
#
#   gke-chat        each switchboard thread (using agent.chatImage): into
#                   switchboard's Secret (/etc/switchboard/triage.yaml)
#   gke-triage-f    each lookout incident (using agent.incidentImage):
#                   into Secret lookout-ax/lookout-ax-agent (task.yaml),
#                   which lookout's ax sink stamps a task from per incident
#   gke-watchboard  lookout's per-cluster watchboard (using
#                   agent.incidentImage): into Secret
#                   lookout-ax/lookout-ax-agent (watchboard-task.yaml),
#                   strictly read-only (no VCS/propose-change) with a short
#                   idle timeout (2m) so it frees its worker slot between
#                   warning digest flushes (#133)
#
# When an environment configures GitOps repositories (agent.vcs) or Slack
# incident alerts (slack.alertChannel), the Workspace carries an augmented
# config JSON (.ConfigPath) that layers vcs, the propose-change specialist
# and/or the switchboard alert target onto the baked bundle's base config,
# while --agents-dir keeps the baked recipe's AGENTS.md, MCP config and
# specialists in place and CORE_AGENT_TRUSTED_DIRS trusts both roots in
# memory.
#
# The attach token is why it is a Secret (ax has no secret references
# for env). It is the only credential in the template: lookout and
# switchboard both present it, while Google, GitHub and switchboard
# outbound-ingress tokens stay outside the actor and are injected at
# Substrate's egress gateway. For gke-chat, auth.token_identity in
# agents/sre-triage/gke-chat/.agents/config.json names its holder
# "switchboard", which owns every thread's session. Asserting the Slack
# user instead (switchboard's assert_caller, plus proxy_identities there)
# waits: core-agent's sessions belong to their creator, and switchboard
# adds no contributors, so a thread would answer only the person who
# started it. gke-triage-f has no multi-session block: core-agent serves
# sessions on the token alone, owned by its default identity, and lookout
# asserts no one. It bounds approvals (permissions.approval_timeout): no
# one approves an incident's tool calls, so a call outside the allow
# list fails after 30s rather than holding the turn until its wall-clock
# budget. switchboard relays approvals to Slack, so a thread's calls wait
# for the person, up to core-agent's 30m unattended default and the
# turn's own wall-clock budget.
#
# Both overlays list Substrate's router in attach.allowed_hosts: every
# request arrives through it and ax-task-runner's pass-through, which
# keeps the router's Host, and core-agent answers an unknown Host on a
# loopback listener 421 (core-agent#1358).
apiVersion: ax.io/v1alpha1
kind: Task
metadata:
  atespace: {{ printf "%q" .Atespace }}
spec:
  image: {{ printf "%q" .Image }}
  command:
    - core-agent
{{- if .ConfigPath }}
    # Workspace-rendered config layering environment VCS / alert settings
    # over the baked {{ .Bundle }} recipe.
    - -c
    - {{ .ConfigPath }}
    - --agents-dir=/opt/core-agent/recipes/{{ .Bundle }}/.agents
{{- else }}
    # The recipe baked from agents/sre-triage/{{ .Bundle }} when the
    # image was built (images/agent).
    - -c
    - /opt/core-agent/recipes/{{ .Bundle }}/.agents/config.json
{{- end }}
    - --provider=vertex
    - --model=gemini-3.8-flash
    - --no-repl
    # Session API (what switchboard, lookout's sink and the nightly
    # scenario speak), reached through the runner's spec.http.port
    # pass-through.
    - --attach-listen=127.0.0.1:8484
    - --attach-token=CORE_AGENT_ATTACH_TOKEN
    # On /workspace, so sessions survive suspend, resume and restarts.
    - --session-db
    - --session-db-path=/workspace/.core-agent/sessions.db
    # A long-lived service: the model doesn't declare task boundaries;
    # /done and core-agent's heuristic still can.
    - --checkpoint=operator
{{- if .EnableFileTools }}
    # No bash: propose-change edits cloned GitOps working trees with
    # read_file, edit_file, write_file and grep alongside pure-Go vcs_*
    # tools, while the distroless image carries no shell or git binary.
    - --disable-tools=bash,read_many_files,view_file_outline,delete_file,stat,list_dir,glob
{{- else }}
    # No bash or file tools: the agent reads clusters through lookout mcp
    # (and leeway mcp on gke-chat; the image has no kubectl), and
    # every tool's schema rides along in every model call. On a
    # multi-session daemon only an admin may approve bash (core-agent
    # #1355), so a Slack approval would be refused anyway.
    - --disable-tools=bash,read_file,read_many_files,view_file_outline,write_file,edit_file,delete_file,stat,list_dir,glob,grep
{{- end }}
    # core-agent's small-model agentic tools read files and URLs, so with
    # the file tools gone it refuses to start unless they're off too;
    # the MCP digests behind retrieve_raw are separate and stay.
    - --agentic-tools=false
    # No background subagents: the model delegates through a specialist's
    # own tool (synchronous, its answer in the same turn) or not at all.
    # spawn_agent's async route returned before the specialist did, and
    # its schema rode in every call.
    - --no-background-agents
    # No startup fetch of LiteLLM's price list (raw.githubusercontent.com
    # is outside the egress below, and the fetch blocks the listener for
    # up to 30s); the built-in table prices Gemini.
    - --no-pricing-refresh
    # The Workspace's AGENTS.md: known clusters, repeat rules, and any
    # GitOps / Slack alert instructions.
    - --agents-content-dir=/workspace/repo
  env:
    # Outbound calls carry placeholders; Substrate's egress gateway injects
    # the real tokens from ate-credentials.
    - name: CORE_AGENT_GOOGLE_AUTH
      value: injected
{{- if .VCSSecret }}
    - name: CORE_AGENT_GITHUB_TOKEN
      value: injected
{{- end }}
{{- if .SwitchboardIngress }}
    - name: CORE_AGENT_SWITCHBOARD_TOKEN
      value: injected
{{- end }}
    - name: CORE_AGENT_TRUSTED_DIRS
      value: "/workspace/repo,/opt/core-agent/recipes/{{ .Bundle }}/.agents"
    - name: GOOGLE_CLOUD_PROJECT
      value: {{ printf "%q" .Project }}
    # core-agent requires an explicit Vertex AI location.
    - name: GOOGLE_CLOUD_LOCATION
      value: global
{{- if .LookoutScope }}
    # Live cluster discovery scope for lookout mcp (#104): comma-separated
    # <project>, <project>/<location>, or fleet:<host>. gke-chat omits
    # --clusters-from on the CLI so lookout reads this variable.
    - name: LOOKOUT_CLUSTERS_FROM
      value: {{ printf "%q" .LookoutScope }}
{{- end }}
{{- if .LeewayScope }}
    # Live cluster discovery scope for leeway mcp (#104, #127): comma-separated
    # <project> or <project>/<location>. Both fleet: (unsupported in leeway
    # v0.1.9) and explicit path: entries (to preserve leeway's ambient
    # multi-cluster refusal guard) are omitted; gke-chat passes full cluster
    # paths discovered via lookout_k8s_list_clusters to leeway_report.
    - name: LEEWAY_CLUSTERS_FROM
      value: {{ printf "%q" .LeewayScope }}
{{- end }}
    - name: CORE_AGENT_ATTACH_TOKEN
      value: {{ printf "%q" .AttachToken }}
  egress:
    - hosts: [{{ .GoogleHosts }}]
      credentials:
        - header: Authorization
          prefix: "Bearer "
          credentialUri: ate-secret://k8s.io/default/ate-credentials/google-token/token
{{- if .VCSSecret }}
    - hosts: [api.github.com]
      credentials:
        - header: Authorization
          prefix: "Bearer "
          credentialUri: ate-secret://k8s.io/default/ate-credentials/{{ .VCSSecret }}/bearer
    - hosts: [github.com]
      credentials:
        - header: Authorization
          prefix: "Basic "
          credentialUri: ate-secret://k8s.io/default/ate-credentials/{{ .VCSSecret }}/basic
{{- end }}
{{- if .SwitchboardIngress }}
    - hosts: ["http://switchboard.switchboard.svc.cluster.local"]
      ports: [8080]
      credentials:
        - header: Authorization
          prefix: "Bearer "
          credentialUri: ate-secret://k8s.io/default/ate-credentials/switchboard-ingress/token
{{- end }}
  http:
    port: 8484
  # Suspended after this idle window without requests (agent.idleSuspendAfter
  # for incident/chat/audit tasks, defaulting to 10m; 2m for watchboard tasks
  # to free worker slots quickly between batched flushes); the router wakes it
  # on the next follow-up.
  idle:
    suspendAfter: {{ .IdleSuspend }}
  # Substrate books these against the worker's limits (the WorkerPool in
  # deploy/profiles/substrate/workers sizes workers for three agents);
  # it requires both.
  resources:
    limits:
      cpu: 500m
      memory: 1Gi
  workspace:
    name: {{ printf "%q" .Workspace }}
    path: /workspace/repo
  debug: {{ if .VCSSecret }}false{{ else }}true{{ end }}
