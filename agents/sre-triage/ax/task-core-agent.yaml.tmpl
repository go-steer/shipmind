# The ax task the agent runs as on core-agent, in serve mode, instead of
# mast (#48), rendered once per use with that use's bundle:
#
#   gke-chat      each switchboard thread, when the environment sets
#                 agent.chatImage: into switchboard's Secret
#                 (/etc/switchboard/triage.yaml)
#   gke-triage-f  each lookout incident, when it sets agent.incidentImage:
#                 into Secret lookout-ax/lookout-ax-agent, which lookout's
#                 ax sink stamps a task from per incident
#
# The attach token is why it is a Secret (ax has no secret references
# for env). It is the only credential: lookout and switchboard both
# present it. For gke-chat, auth.token_identity in
# agents/sre-triage/ax/core-agent-gke-chat.json names its holder
# "switchboard", which owns every thread's session. Asserting the Slack
# user instead (switchboard's assert_caller, plus proxy_identities there)
# waits: core-agent's sessions belong to their creator, and switchboard
# adds no contributors, so a thread would answer only the person who
# started it. gke-triage-f has no multi-session block: core-agent serves
# sessions on the token alone, owned by its default identity, and lookout
# asserts no one. It bounds approvals (permissions.approval_timeout): no
# one approves an incident's tool calls, so a call outside the allow
# list fails after 30s rather than holding the turn until its wall-clock
# budget. switchboard relays approvals to Slack, so a thread's calls wait
# for the person, up to core-agent's 30m unattended default and the
# turn's own wall-clock budget.
#
# Both overlays list Substrate's router in attach.allowed_hosts: every
# request arrives through it and ax-task-runner's pass-through, which
# keeps the router's Host, and core-agent answers an unknown Host on a
# loopback listener 421 (core-agent#1358).
apiVersion: ax.io/v1alpha1
kind: Task
metadata:
  atespace: {{ printf "%q" .Atespace }}
spec:
  image: {{ printf "%q" .Image }}
  command:
    - core-agent
    # The bundle, converted from agents/sre-triage/{{ .Bundle }} when the
    # image was built (images/agent).
    - -c
    - /opt/core-agent/recipes/{{ .Bundle }}/.agents/config.json
    - --provider=vertex
    - --model=gemini-3.8-flash
    - --no-repl
    # Session API (what switchboard, lookout's sink and the nightly
    # scenario speak), reached through the runner's spec.http.port
    # pass-through.
    - --attach-listen=127.0.0.1:8484
    - --attach-token=CORE_AGENT_ATTACH_TOKEN
    # On /workspace, so sessions survive suspend, resume and restarts.
    - --session-db
    - --session-db-path=/workspace/.core-agent/sessions.db
    # A long-lived service: the model doesn't declare task boundaries;
    # /done and core-agent's heuristic still can.
    - --checkpoint=operator
    # No bash or file tools: the agent reads clusters through GKE's MCP
    # server (the image has no kubectl), mast's bundles had neither, and
    # every tool's schema rides along in every model call. On a
    # multi-session daemon only an admin may approve bash (core-agent
    # #1355), so a Slack approval would be refused anyway.
    - --disable-tools=bash,read_file,read_many_files,view_file_outline,write_file,edit_file,delete_file,stat,list_dir,glob,grep
    # core-agent's small-model agentic tools read files and URLs, so with
    # the file tools gone it refuses to start unless they're off too;
    # the MCP digests behind retrieve_raw are separate and stay.
    - --agentic-tools=false
    # No startup fetch of LiteLLM's price list (raw.githubusercontent.com
    # is outside the egress below, and the fetch blocks the listener for
    # up to 30s); the built-in table prices Gemini.
    - --no-pricing-refresh
    # The Workspace's AGENTS.md: known clusters and the repeat rule.
    - --agents-content-dir=/workspace/repo
  env:
    # Google calls carry a placeholder; the egress gateway injects the
    # token refresher's access token.
    - name: CORE_AGENT_GOOGLE_AUTH
      value: injected
    - name: GOOGLE_CLOUD_PROJECT
      value: {{ printf "%q" .Project }}
    # core-agent has no default location (mast defaulted to global).
    - name: GOOGLE_CLOUD_LOCATION
      value: global
    - name: CORE_AGENT_ATTACH_TOKEN
      value: {{ printf "%q" .AttachToken }}
  egress:
    - hosts: [aiplatform.googleapis.com, container.googleapis.com]
      credentials:
        - header: Authorization
          prefix: "Bearer "
          credentialUri: ate-secret://k8s.io/default/ate-credentials/google-token/token
  http:
    port: 8484
  # Suspended after 10 minutes without requests; the router wakes it on
  # the next follow-up.
  idle:
    suspendAfter: 10m
  # Substrate books these against the worker's limits (the WorkerPool in
  # deploy/profiles/substrate/workers sizes workers for three agents);
  # it requires both.
  resources:
    limits:
      cpu: 500m
      memory: 1Gi
  workspace:
    name: {{ printf "%q" .Workspace }}
    path: /workspace/repo
  debug: true
