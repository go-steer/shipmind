# The ax task every incident runs as: lookout's ax sink stamps a copy of
# this per incident, named lookout-<hash of the incident fingerprint>.
# `shipmind up` renders it with the environment's values and the agent's
# tokens into Secret lookout-ax/lookout-ax-agent; the tokens are why it is
# a Secret (ax has no secret references for env).
apiVersion: ax.io/v1alpha1
kind: Task
metadata:
  atespace: {{ printf "%q" .Atespace }}
spec:
  image: {{ printf "%q" .Image }}
  command:
    - mast
    # The bundle: gke-triage-f for lookout's incidents, gke-chat for
    # switchboard's threads (internal/agent).
    - --workload=/opt/mast/workloads/{{ .Bundle }}
    - --provider=vertex
    - --model=gemini-3.8-flash
    - --listen=127.0.0.1:7777
    # Session API (what switchboard and lookout's sink speak), reached
    # through the runner's spec.http.port pass-through.
    - --attach-listen=127.0.0.1:8484
    - --session-db=/workspace/.mast/sessions.db
    # The Workspace's AGENTS.md: known clusters and the repeat rule.
    - --instructions=/workspace/repo
  env:
    # Google calls carry a placeholder; the egress gateway injects the
    # token refresher's access token.
    - name: MAST_GOOGLE_AUTH
      value: injected
    - name: GOOGLE_CLOUD_PROJECT
      value: {{ printf "%q" .Project }}
    - name: MAST_INJECT_TOKEN
      value: {{ printf "%q" .InjectToken }}
    - name: MAST_ATTACH_TOKEN
      value: {{ printf "%q" .AttachToken }}
  egress:
    - hosts: [aiplatform.googleapis.com, container.googleapis.com]
      credentials:
        - header: Authorization
          prefix: "Bearer "
          credentialUri: ate-secret://k8s.io/default/ate-credentials/google-token/token
  http:
    port: 8484
  # Suspended after 10 minutes without requests; the router wakes it on
  # the next follow-up.
  idle:
    suspendAfter: 10m
  # Substrate books these against the worker's limits (the WorkerPool in
  # deploy/profiles/substrate/workers sizes workers for three agents);
  # it requires both.
  resources:
    limits:
      cpu: 500m
      memory: 1Gi
  workspace:
    name: {{ printf "%q" .Workspace }}
    path: /workspace/repo
  debug: true
