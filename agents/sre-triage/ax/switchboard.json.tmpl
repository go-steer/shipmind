{
  "platform": "slack",
  "agents": [
    {
      "name": "triage",
      "display_name": "SRE & GitOps",
      "description": "Answers questions, investigates GKE clusters, and proposes GitOps pull requests",
      "kind": "ax",
      "token_env": "SWITCHBOARD_AGENT_TOKEN_TRIAGE",
      "ax": {
        "server": "ax-server.ax-system.svc.cluster.local:8080",
        "atespace": {{ printf "%q" .Atespace }},
        "task_template_file": "/etc/switchboard/triage.yaml",
        "scope": "thread"
      }
    }
  ],
  "default_agent": "triage",
  "caller_id": "email",
  "metrics_addr": ":9090",{{ if .AlertChannel }}
  "ingress_addr": ":8080",
  "ingress_token_env": "SWITCHBOARD_INGRESS_TOKEN",
  "ingress_allow": [{{ printf "%q" .AlertChannel }}],{{ end }}
  "defaults": {
    "progress_mode": "status",
    "approvals": true,
    "standing_approvers": ["nobody"],
    "show_usage": true
  },
  "slack_rich_blocks": true,
  "slack_app_token_env": "SWITCHBOARD_SLACK_APP_TOKEN",
  "slack_bot_token_env": "SWITCHBOARD_SLACK_BOT_TOKEN"
}
