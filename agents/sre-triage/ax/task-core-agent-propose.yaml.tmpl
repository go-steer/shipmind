# The ax task switchboard starts for a "propose" thread when the
# environment configures agent.vcs (with agent.chatImage): the chat
# bundle's GKE read-only specialist plus core-agent's vcs_* tools and
# builtin:propose-change workflow, with read_file, edit_file, write_file
# and grep enabled so the agent can edit cloned manifests and open pull
# requests behind switchboard's Slack approval buttons.
#
# The GitHub token never enters the actor: CORE_AGENT_GITHUB_TOKEN is a
# placeholder, and Substrate's egress gateway injects Bearer on
# api.github.com and Basic on github.com from ate-credentials/<secret>.
apiVersion: ax.io/v1alpha1
kind: Task
metadata:
  atespace: {{ printf "%q" .Atespace }}
spec:
  image: {{ printf "%q" .Image }}
  command:
    - core-agent
    - -c
    - /workspace/repo/propose-config.json
    - --agents-dir=/opt/core-agent/recipes/{{ .Bundle }}/.agents
    - --provider=vertex
    - --model=gemini-3.8-flash
    - --no-repl
    - --attach-listen=127.0.0.1:8484
    - --attach-token=CORE_AGENT_ATTACH_TOKEN
    - --session-db
    - --session-db-path=/workspace/.core-agent/sessions.db
    - --checkpoint=operator
    - --disable-tools=bash,read_many_files,view_file_outline,delete_file,stat,list_dir,glob
    - --agentic-tools=false
    - --no-background-agents
    - --no-pricing-refresh
    - --agents-content-dir=/workspace/repo
  env:
    - name: CORE_AGENT_GOOGLE_AUTH
      value: injected
    - name: CORE_AGENT_GITHUB_TOKEN
      value: injected
    # Explicit --agents-dir disables core-agent's -c auto-trust; trust
    # the Workspace and baked recipe in memory without writing to $HOME.
    - name: CORE_AGENT_TRUSTED_DIRS
      value: "/workspace/repo,/opt/core-agent/recipes/{{ .Bundle }}/.agents"
    - name: GOOGLE_CLOUD_PROJECT
      value: {{ printf "%q" .Project }}
    - name: GOOGLE_CLOUD_LOCATION
      value: global
    - name: CORE_AGENT_ATTACH_TOKEN
      value: {{ printf "%q" .AttachToken }}
  egress:
    - hosts: [aiplatform.googleapis.com, container.googleapis.com]
      credentials:
        - header: Authorization
          prefix: "Bearer "
          credentialUri: ate-secret://k8s.io/default/ate-credentials/google-token/token
    - hosts: [api.github.com]
      credentials:
        - header: Authorization
          prefix: "Bearer "
          credentialUri: ate-secret://k8s.io/default/ate-credentials/{{ .VCSSecret }}/bearer
    - hosts: [github.com]
      credentials:
        - header: Authorization
          prefix: "Basic "
          credentialUri: ate-secret://k8s.io/default/ate-credentials/{{ .VCSSecret }}/basic
  http:
    port: 8484
  idle:
    suspendAfter: {{ .IdleSuspend }}
  resources:
    limits:
      cpu: 500m
      memory: 1Gi
  workspace:
    name: {{ printf "%q" .Workspace }}
    path: /workspace/repo
  debug: false
